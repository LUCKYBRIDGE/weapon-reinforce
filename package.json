{
  "name": "weapon-reinforce",
  "private": true,
  "version": "1.2.0",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-runtime-public.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-runtime-public.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "validate:weapons": "node scripts/validate-weapon-timeline.mjs",
    "validate:quizzes": "node scripts/validate-quiz-catalog.mjs",
    "validate:saves": "node scripts/validate-save-state.mjs",
    "validate:save-file": "node scripts/validate-game-save.mjs",
    "validate:expedition": "node scripts/validate-expedition.mjs",
    "validate:economy": "node scripts/validate-expedition-economy.mjs",
    "validate:balance": "node scripts/simulate-game-balance.mjs",
    "validate:runtime": "node scripts/validate-runtime-assets.mjs",
    "validate:release": "node scripts/validate-release-readiness.mjs",
    "validate:publish": "node scripts/validate-release-publish.mjs",
    "validate:all": "npm run validate:weapons && npm run validate:quizzes && npm run validate:saves && npm run validate:save-file && npm run validate:economy && npm run validate:expedition && npm run validate:balance && npm run validate:release && npm run lint && npm run build && npm run validate:runtime",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
